FROM rust:1-slim-bookworm AS nexus
WORKDIR /engine
COPY engines/nexus-core/ ./
RUN cargo build --release --locked

FROM node:26.11.1-bookworm-slim AS web
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY tailwind.config.js postcss.config.js components.json ./
COPY src ./src
COPY reference ./reference
COPY public ./public
RUN npm run build

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENV ENV=prod
WORKDIR /app/backend
COPY backend/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY backend ./
COPY reference /app/reference
COPY docker-entrypoint.prod.sh /usr/local/bin/foggara-entrypoint
COPY --from=nexus /engine/target/release/foggara-nexus-core /usr/local/bin/foggara-nexus-core
ENV NEXUS_MATRIX_ENGINE=rust
COPY --from=web /app/dist /app/dist
RUN useradd --create-home foggara && chown -R foggara:foggara /app
USER foggara
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:' + __import__('os').environ.get('PORT', '8000') + '/api/health', timeout=4)"
CMD ["/bin/sh", "/usr/local/bin/foggara-entrypoint"]
