{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:matrix": "node --test tests/presentation-matrix.test.mjs",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
