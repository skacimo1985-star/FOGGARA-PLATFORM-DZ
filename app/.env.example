# ── FOGGARA-DZ — مثال تهيئة البيئة ─────────────────────────────
# انسخ هذا الملف إلى .env وعبّئ القيم. لا تُودع .env في git أبدًا.
# كل متغير موثق أدناه؛ لا توجد قيم حقيقية في هذا الملف.

# بيئة التشغيل: dev (تطوير/تجربة) أو prod (إنتاج).
# عند prod يُرفض إقلاع التطبيق بـ JWT_SECRET الافتراضي أو الأقصر من 32 حرفًا.
ENV=prod

# سر توقيع توكنات JWT. أنشئ قيمة قوية هكذا:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# مدة صلاحية التوكن بالساعات (افتراضي 12).
TOKEN_TTL_HOURS=12

# رابط قاعدة البيانات PostgreSQL (سائق psycopg).
# داخل docker-compose يشير إلى خدمة db:
DATABASE_URL=postgresql+psycopg://foggara:CHANGE_ME@db:5432/foggara

# قائمة أصول CORS المسموحة مفصولة بفواصل.
# اتركها فارغة (الافتراضي) = نفس الأصل فقط، بلا رؤوس CORS.
# مثال: CORS_ORIGINS=https://app.example.dz,https://admin.example.dz
CORS_ORIGINS=

# مستوى السجلات: DEBUG أو INFO أو WARNING أو ERROR (افتراضي INFO).
LOG_LEVEL=INFO

# منفذ الاستماع داخل الحاوية (افتراضي 8000).
PORT=8000

# ── قاعدة البيانات في docker-compose (خدمة db) ─────────────────
POSTGRES_USER=foggara
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=foggara

# ── النشر السحابي (Supabase + Render) ──────────────────────────
# مثال رابط Supabase Session Pooler المناسب لسائق psycopg:
#   DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# (تُقبل أيضًا صيغتا postgresql:// و postgres:// وتُحوَّلان تلقائيًا إلى psycopg.)

# بذر بيانات DEMO: في الإنتاج الافتراضي false — أبقِها false دائمًا في الإنتاج.
SEED_DEMO=false

# مفتاح مسار الإعداد لمرة واحدة POST /api/setup/bootstrap (إنشاء أول مدير).
# بدون هذا المتغير يكون المسار معطّلًا تمامًا (403 SETUP_DISABLED).
# أنشئ قيمة قوية: python -c "import secrets; print(secrets.token_hex(24))"
# بعد إنشاء المدير الأول يُغلق المسار تلقائيًا (409 SETUP_CLOSED) ويمكن حذف المتغير.
SETUP_KEY=

# ── تشديد إنتاجي (قيم افتراضية آمنة، لا تُضبط عادةً) ───────────
# سقف سجلات القوائم العامة (افتراضي 500).
LIST_MAX_LIMIT=500
# مهلة الاستعلام الواحد بالمللي ثانية على PostgreSQL (افتراضي 30000).
DB_STATEMENT_TIMEOUT_MS=30000
# تحديد معدل الدخول: عدد المحاولات / النافذة بالثواني لكل عنوان (افتراضي 10/60).
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
# تحديد معدل مسار الإعداد لمرة واحدة (افتراضي 5/600).
RATE_LIMIT_SETUP_MAX=5
RATE_LIMIT_SETUP_WINDOW=600
# الثقة بترويسة X-Forwarded-For لتحديد معدل الطلبات (خلف بروكسي استضافة).
# الافتراضي false في كل البيئات. فعّلها فقط خلف بروكسي ينظف عنوان العميل.
TRUST_PROXY_HEADERS=
# سقف مفاتيح عدّاد المعدل في الذاكرة قبل إخلاء المفاتيح الميتة (افتراضي 10000).
RL_MAX_KEYS=10000
