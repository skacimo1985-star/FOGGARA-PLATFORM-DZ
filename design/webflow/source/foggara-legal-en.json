                    ],
                    "children": [
                      {
                        "type": "String",
                        "text": "No new advertising or marketing analytics tools were added in this version. Hosting, browsers and external services may use technical data needed for operation and security."
                      }
                    ]
                  },
                  {
                    "type": "Paragraph",
                    "classes": [
                      "lp-copy"
                    ],
                    "children": [
                      {
                        "type": "String",
                        "text": "Cookies and storage on the published domain must be reviewed before optional tracking is enabled. This notice is not a consent manager and does not certify the absence of third-party cookies. You can manage cookies through your browser settings."
